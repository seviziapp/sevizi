{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "credentialsSource": "local"
      }
    },
    "sevigo": {
      "extends": "production",
      "autoIncrement": false,
      "env": {
        "APP_VARIANT": "sevigo"
      },
      "android": {
        "credentialsSource": "remote",
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./credentials/google-service-account.json",
        "track": "production"
      }
    }
  }
}
